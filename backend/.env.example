# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env asli.

# --- Wajib ---
GOOGLE_API_KEY=
SECRET_KEY=ganti-dengan-string-acak-panjang   # mis. hasil: openssl rand -hex 32
ADMIN_PASSWORD=ganti-password-admin-yang-kuat

# --- Opsional (punya default) ---
ADMIN_USERNAME=admin
CHROMA_DB_PATH=./chroma_db
UPLOAD_DIR=uploads
DATABASE_URL=sqlite+aiosqlite:///./compliance.db
ENVIRONMENT=development                          # set "production" saat deploy
CORS_ORIGINS=http://localhost:3000              # pisahkan dengan koma bila banyak
